nums=[3, 1, 4, 1, 5]
k=2
count={}
answer=0
for num in nums:
    if num-k in count:
        answer=answer+count[num-k]
    if num+k in count:
        answer=answer+count[num+k]
    if num in count:
        count[num]=count[num]+1
    else:
        count[num]=1
print("Number of unique pairs:",answer)
